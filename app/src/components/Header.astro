---
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, localized_path, type Language } from '../i18n';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const section_links = [
	{ id: 'projects', label: t(lang, 'nav.projects') },
	{ id: 'experience', label: t(lang, 'nav.experience') },
	{ id: 'about', label: t(lang, 'nav.about') },
	{ id: 'skills', label: t(lang, 'nav.skills') },
	{ id: 'contact', label: t(lang, 'nav.contact') },
];
---

<header class="site-header">
	<div class="site-header__bar">
		<a class="site-header__brand" href={localized_path(lang, '/')} aria-label="Mehmet Güzel">
			<img class="site-header__logo" src="/mehmet-guzel.webp" alt="" width="32" height="32" />
			<span class="site-header__name">Mehmet Güzel</span>
		</a>

		<nav class="site-header__nav" id="site-nav" aria-label={t(lang, 'nav.label')}>
			{section_links.map((link) => <a href={localized_path(lang, `/#${link.id}`)} data-section={link.id}>{link.label}</a>)}
			<a href={localized_path(lang, '/blog/')} data-section="blog-page">{t(lang, 'nav.blog')}</a>
		</nav>

		<div class="site-header__actions">
			<details class="cv-menu">
				<summary class="btn cv-menu__summary">{t(lang, 'nav.cv_download')}</summary>
				<ul class="cv-menu__list glass">
					<li>
						<a href="/Mehmet_Guzel_CV_EN.pdf" download hreflang="en">{t(lang, 'nav.cv_english')}</a>
					</li>
					<li>
						<a href="/Mehmet_Guzel_CV.pdf" download hreflang="tr">{t(lang, 'nav.cv_turkish')}</a>
					</li>
				</ul>
			</details>
			<LanguageSwitch lang={lang} />
			<ThemeToggle label={t(lang, 'theme.toggle')} />
			<button
				type="button"
				class="site-header__burger"
				aria-label={t(lang, 'nav.menu')}
				aria-expanded="false"
				aria-controls="site-nav"
			>
				<span></span><span></span><span></span>
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const burger = header?.querySelector<HTMLButtonElement>('.site-header__burger');
	const nav_links = header?.querySelectorAll<HTMLAnchorElement>('.site-header__nav a') ?? [];
	const cv_menu = header?.querySelector<HTMLDetailsElement>('.cv-menu');

	const set_menu_open = (open: boolean) => {
		header?.classList.toggle('is-open', open);
		burger?.setAttribute('aria-expanded', String(open));
	};

	burger?.addEventListener('click', () => set_menu_open(!header?.classList.contains('is-open')));
	nav_links.forEach((link) => link.addEventListener('click', () => set_menu_open(false)));

	document.addEventListener('click', (event) => {
		if (cv_menu?.open && !cv_menu.contains(event.target as Node)) cv_menu.open = false;
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		set_menu_open(false);
		if (cv_menu?.open) {
			cv_menu.open = false;
			cv_menu.querySelector('summary')?.focus();
		}
	});

	const stuck_class = 'is-stuck';
	const update_stuck = () => header?.classList.toggle(stuck_class, scrollY > 24);
	addEventListener('scroll', update_stuck, { passive: true });
	update_stuck();

	if (location.pathname.includes('/blog')) {
		header?.querySelector('[data-section="blog-page"]')?.setAttribute('aria-current', 'page');
	}

	const observed_sections = [...nav_links]
		.map((link) => document.getElementById(link.dataset.section ?? ''))
		.filter((section): section is HTMLElement => section !== null);

	if (observed_sections.length > 0) {
		const section_observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					nav_links.forEach((link) =>
						link.toggleAttribute('aria-current', link.dataset.section === entry.target.id),
					);
				}
			},
			{ rootMargin: '-45% 0px -50% 0px' },
		);
		observed_sections.forEach((section) => section_observer.observe(section));
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--enamel);
		color: var(--enamel-text);
		transition: box-shadow 0.2s ease;
	}

	.site-header.is-stuck {
		box-shadow: 0 10px 18px -14px rgba(0, 0, 0, 0.6);
	}

	.site-header__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(100% - 2rem, var(--container));
		margin-inline: auto;
		padding-block: 0.7rem;
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--enamel-text);
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 800;
		font-stretch: 72%;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.site-header__logo {
		width: 2.1rem;
		height: 2.1rem;
		border: 2px solid var(--brass);
		border-radius: 50%;
		object-fit: cover;
	}

	.site-header__nav {
		display: flex;
		gap: 0.25rem;
	}

	.site-header__nav a {
		position: relative;
		padding: 0.5rem 0.7rem;
		color: var(--enamel-muted);
		font-size: 0.92rem;
		font-weight: 700;
		font-stretch: 78%;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.site-header__nav a:hover {
		color: var(--enamel-text);
	}

	.site-header__nav a[aria-current] {
		color: var(--enamel-text);
	}

	.site-header__nav a[aria-current]::after {
		content: '';
		position: absolute;
		left: 0.7rem;
		right: 0.7rem;
		bottom: 0.1rem;
		height: 4px;
		background: var(--guide);
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	/* The language and theme controls sit on the enamel strip, so they take its ink. */
	.site-header__actions :global(.language-switch),
	.site-header__actions :global(.theme-toggle) {
		border: 2px solid color-mix(in srgb, var(--enamel-text) 70%, transparent);
		border-radius: var(--radius);
		background: transparent;
		color: var(--enamel-text);
	}

	.site-header__actions :global(.language-switch:hover),
	.site-header__actions :global(.theme-toggle:hover) {
		border-color: var(--enamel-text);
	}

	.cv-menu {
		position: relative;
	}

	.cv-menu__summary {
		padding: 0.5rem 1rem 0.45rem;
		border-color: var(--guide);
		color: var(--enamel-text);
		font-size: 0.85rem;
		white-space: nowrap;
		list-style: none;
	}

	.cv-menu__summary:hover,
	.cv-menu[open] .cv-menu__summary {
		background: var(--guide);
		color: #151614;
	}

	.cv-menu__summary::-webkit-details-marker {
		display: none;
	}

	.cv-menu__list {
		position: absolute;
		top: calc(100% + 0.75rem);
		right: 0;
		min-width: 11rem;
		padding: 0.35rem;
		background: var(--surface-strong);
		list-style: none;
	}

	.cv-menu__list a {
		display: block;
		padding: 0.6rem 0.85rem;
		color: var(--text);
		font-weight: 600;
		text-decoration: none;
	}

	.cv-menu__list a:hover {
		background: var(--guide);
		color: #151614;
	}

	.site-header__burger {
		display: none;
		width: 2.6rem;
		height: 2.6rem;
		padding: 0;
		border: 2px solid var(--enamel-text);
		border-radius: var(--radius);
		background: transparent;
		cursor: pointer;
	}

	.site-header__burger span {
		display: block;
		width: 1.1rem;
		height: 2px;
		margin: 4px auto;
		background: var(--enamel-text);
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.is-open .site-header__burger span:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.is-open .site-header__burger span:nth-child(2) {
		opacity: 0;
	}

	.is-open .site-header__burger span:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	@media (max-width: 960px) {
		.site-header__burger {
			display: inline-block;
		}

		.site-header__nav {
			position: absolute;
			top: 100%;
			left: -1rem;
			right: -1rem;
			flex-direction: column;
			padding: 0.5rem 1rem 1rem;
			border-bottom: 6px solid var(--guide);
			background: var(--enamel-deep);
			opacity: 0;
			transform: translateY(-0.5rem);
			pointer-events: none;
			visibility: hidden;
			transition:
				opacity 0.2s ease,
				transform 0.2s ease,
				visibility 0.2s;
		}

		.is-open .site-header__nav {
			opacity: 1;
			transform: none;
			pointer-events: auto;
			visibility: visible;
		}

		.site-header__nav a {
			padding: 0.85rem 0.7rem;
			font-size: 1.05rem;
		}

		.site-header__nav a[aria-current]::after {
			left: 0;
			right: auto;
			top: 0.85rem;
			bottom: 0.85rem;
			width: 4px;
			height: auto;
			margin-left: -0.6rem;
		}
	}

	@media (max-width: 520px) {
		.site-header__name {
			display: none;
		}

		.site-header__actions {
			gap: 0.4rem;
		}

		.cv-menu__summary {
			padding-inline: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header__nav,
		.site-header__burger span {
			transition: none;
		}
	}
</style>
