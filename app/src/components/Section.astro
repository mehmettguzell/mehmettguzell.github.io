---
interface Props {
	id: string;
	hall: string;
	title: string;
	lead?: string;
	/** Off when the floor guide into this hall is already drawn just above it. */
	show_hall_guide?: boolean;
}

const { id, hall, title, lead, show_hall_guide = true } = Astro.props;
---

<section class:list={['section', { 'section--threshold': show_hall_guide }]} id={id} aria-labelledby={`${id}-title`}>
	{show_hall_guide && <p class="hall-threshold"><span class="container hall-guide">{hall}</span></p>}
	<div class="container">
		<header class="section__header" data-reveal>
			<h2 class="section__title" id={`${id}-title`}>{title}</h2>
			{lead && <p class="section__lead">{lead}</p>}
		</header>
		<slot />
	</div>
</section>

<style>
	.section__header {
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
	}
</style>
