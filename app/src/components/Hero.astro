---
import Wallz from './Wallz.astro';
import Icon from './Icon.astro';
import contact from '../data/contact.json';
import projects from '../data/projects.json';
import { t, localized_path, type Language } from '../i18n';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;

const exhibit_label_keys = ['based', 'education', 'experience', 'stack', 'languages'] as const;
const exhibit_label_rows = exhibit_label_keys.map((key) => ({
	label: t(lang, `glance.${key}`),
	value: t(lang, `glance.${key}_value`),
}));
const first_exhibit_count = 3;
const first_exhibits = projects.slice(0, first_exhibit_count);
const cv_path = lang === 'tr' ? '/Mehmet_Guzel_CV.pdf' : '/Mehmet_Guzel_CV_EN.pdf';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__wall">
		<div class="container hero__grid">
			<div class="hero__copy">
				<h1 id="hero-title" class="hero__name" data-reveal style="--delay: 80ms">
					<span>Mehmet</span> <span>Güzel</span>
				</h1>
				<p class="hero__role" data-reveal style="--delay: 160ms">{t(lang, 'hero.status')}</p>
				<p class="hero__lead" data-reveal style="--delay: 220ms">{t(lang, 'hero.lead')}</p>
				<div class="hero__actions" data-reveal style="--delay: 280ms">
					<a class="push-button" href={cv_path} download>
						<span class="push-button__cap" aria-hidden="true"></span>
						<span class="push-button__label">{t(lang, 'hero.cta_cv')} <Icon name="download" /></span>
					</a>
					<a class="btn hero__projects" href={localized_path(lang, '/#projects')}>{t(lang, 'hero.cta_projects')} <Icon name="arrow-right" /></a>
				</div>
				<p class="hero__social" data-reveal style="--delay: 340ms">
					<a href={contact.github} rel="noopener" target="_blank">GitHub <Icon name="external" /></a>
					<a href={contact.linkedin} rel="noopener" target="_blank">LinkedIn <Icon name="external" /></a>
					<a href={`mailto:${contact.email}`}>{contact.email}</a>
				</p>
			</div>

			<div class="hero__visual" data-reveal style="--delay: 200ms">
				<div class="hero__stage">
					<button type="button" class="hero__wallz" data-state="idle" aria-label={t(lang, 'wallz.label')} data-action-status={t(lang, 'wallz.action_status')}>
						<Wallz />
					</button>
					<span class="hero__hint" aria-hidden="true">{t(lang, 'wallz.hint')}</span>
					<p class="hero__wallz-status" role="status"></p>
					<span class="hero__plinth" aria-hidden="true"></span>
				</div>
				<div class="hero__plate">
					<p class="hero__plate-title placard">{t(lang, 'hero.exhibit')}</p>
					<dl class="hero__plate-list">
					{
						exhibit_label_rows.map((row) => (
							<div class="hero__plate-row">
								<dt class="placard">{row.label}</dt>
								<dd>{row.value}</dd>
							</div>
						))
					}
				</dl>
				</div>
			</div>
		</div>
	</div>
	<div class="hero__floor">
		<div class="container">
			<a class="hall-guide hero__guide" href={localized_path(lang, '/#projects')}>{t(lang, 'projects.eyebrow')}</a>
			<ul class="hero__exhibits">
				{
					first_exhibits.map((project, index) => (
						<li>
							<a class="hero__exhibit-plate placard" href={`#${project.slug}`}>
								No. {String(index + 1).padStart(2, '0')} · {project.short_name}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const reduced_motion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const wallz_button = document.querySelector<HTMLButtonElement>('.hero__wallz');
	const wallz_status = document.querySelector<HTMLElement>('.hero__wallz-status');

	if (wallz_button && wallz_status && !reduced_motion) {
		const left_arm = '#wallz-arm-l';
		const right_arm = '#wallz-arm-r';
		const both_arms = [left_arm, right_arm];
		const right_arm_shapes = '#wallz-arm-r .wallz__arm-outline, #wallz-arm-r .wallz__arm-fill';
		const fingers_over_banana = '.wallz__grip';
		const raised_arm_degrees = 128;
		const slam_strengths = [1, 1.2, 1.5];
		const eye_travel_pixels = 2.5;
		const frowning_brow_drop = 2.5;
		const frowning_brow_scale = 1.15;
		const waving_arm_degrees = 140;
		const wave_swing_degrees = 14;
		const wave_swing_repeats = 5;
		const wave_trigger_scroll_pixels = 40;
		const wave_reset_scroll_pixels = 10;
		const closed_mouth = 'M108 90Q120 98 132 90Z';
		const roaring_mouth = 'M104 86Q120 112 136 86Z';
		const chewing_mouth = 'M110 88Q120 104 130 88Z';
		const resting_arm = 'M174 104C198 120 204 152 196 182';
		const eating_arm = 'M174 104C206 130 198 150 170 112';
		const mouth_hand_offset = { x: -26, y: -78 };
		const banana_toward_mouth_degrees = 20;
		const banana_scale = 1.2;
		const pause_to_show_the_banana_seconds = 0.3;
		const banana_drop_height = 170;
		const bite_edge_x_after_each_bite = [158, 172, 188, 204, 240];
		const bite_edge_x_untouched = 140;

		let is_performing = false;

		gsap.set(left_arm, { svgOrigin: '66 104' });
		gsap.set(right_arm, { svgOrigin: '174 104' });
		gsap.set('#wallz-torso', { svgOrigin: '120 206' });
		gsap.set('#wallz-head', { svgOrigin: '120 100' });
		gsap.set('#wallz-eyes', { svgOrigin: '120 64' });
		gsap.set('#wallz-brow', { svgOrigin: '120 56' });
		gsap.set('#wallz-shadow', { svgOrigin: '120 219' });
		gsap.set('#wallz-hand-r', { svgOrigin: '196 190' });
		gsap.set('#wallz-banana', { svgOrigin: '196 190', scale: banana_scale, opacity: 0 });
		gsap.set('#wallz-bite-shape', { x: bite_edge_x_untouched });
		gsap.set('#wallz-dust .wallz__puff', { transformOrigin: '50% 50%' });

		// Idle: slow breathing, a slight arm sway and an occasional blink.
		const breathing = gsap.timeline({ repeat: -1, yoyo: true, defaults: { ease: 'sine.inOut', duration: 2.6 } });
		breathing
			.to('#wallz-torso', { scaleY: 1.03 }, 0)
			.to('#wallz-head', { y: -1.5 }, 0)
			.to(left_arm, { rotation: 2 }, 0)
			.to(right_arm, { rotation: -2 }, 0);

		const schedule_blink = () => {
			gsap.delayedCall(gsap.utils.random(2.5, 5), () => {
				if (!is_performing) gsap.to('#wallz-eyes', { scaleY: 0.1, duration: 0.07, yoyo: true, repeat: 1 });
				schedule_blink();
			});
		};
		schedule_blink();

		addEventListener(
			'pointermove',
			(event) => {
				if (is_performing) return;
				const box = wallz_button.getBoundingClientRect();
				const dx = (event.clientX - (box.left + box.width / 2)) / innerWidth;
				const dy = (event.clientY - (box.top + box.height * 0.3)) / innerHeight;
				gsap.to('#wallz-pupils', {
					x: gsap.utils.clamp(-1, 1, dx * 3) * eye_travel_pixels,
					y: gsap.utils.clamp(-1, 1, dy * 3) * eye_travel_pixels,
					duration: 0.4,
				});
			},
			{ passive: true },
		);

		wallz_button.addEventListener('pointerenter', () => {
			if (is_performing) return;
			gsap.to('#wallz-brow', { y: frowning_brow_drop, scaleY: frowning_brow_scale, duration: 0.2, overwrite: 'auto' });
		});
		wallz_button.addEventListener('pointerleave', () => {
			if (is_performing) return;
			gsap.to('#wallz-brow', { y: 0, scaleY: 1, duration: 0.3, overwrite: 'auto' });
		});

		// Waves once per descent from the top of the page; the breathing sway is paused so it cannot fight the raised arm.
		const hero_section = wallz_button.closest<HTMLElement>('.hero');
		let waving: gsap.core.Timeline | null = null;
		let has_waved_on_this_descent = false;
		let previous_scroll_y = scrollY;
		const wave_when_scrolling_down = () => {
			const is_scrolling_down = scrollY > previous_scroll_y;
			previous_scroll_y = scrollY;
			if (scrollY <= wave_reset_scroll_pixels) has_waved_on_this_descent = false;
			const is_hero_in_view = hero_section !== null && scrollY < hero_section.offsetHeight;
			if (!is_scrolling_down || !is_hero_in_view || scrollY < wave_trigger_scroll_pixels) return;
			if (is_performing || waving || has_waved_on_this_descent) return;
			has_waved_on_this_descent = true;
			breathing.pause();
			waving = gsap
				.timeline({
					onComplete: () => {
						breathing.play();
						waving = null;
					},
				})
				.to(left_arm, { rotation: waving_arm_degrees, duration: 0.4, ease: 'back.out(1.4)' })
				.to(left_arm, { rotation: waving_arm_degrees + wave_swing_degrees, duration: 0.18, ease: 'sine.inOut', yoyo: true, repeat: wave_swing_repeats })
				.to(left_arm, { rotation: 0, duration: 0.4, ease: 'power2.inOut' });
		};
		addEventListener('scroll', wave_when_scrolling_down, { passive: true });

		const main_content = document.querySelector<HTMLElement>('.site-main');
		const shake_screen = (strength: number) => {
			const jolts = 9;
			const first_jolt_pixels = 11 * strength;
			const shake = gsap.timeline({ onComplete: () => gsap.set(main_content, { clearProps: 'transform' }) });
			for (let jolt = 0; jolt < jolts; jolt++) {
				const falloff = (1 - jolt / jolts) ** 1.5;
				const direction = jolt % 2 === 0 ? 1 : -1;
				shake.to(main_content, {
					x: direction * first_jolt_pixels * 0.45 * falloff,
					y: direction * first_jolt_pixels * falloff,
					duration: jolt === 0 ? 0.03 : 0.045,
					ease: jolt === 0 ? 'power2.out' : 'sine.inOut',
				});
			}
			shake.to(main_content, { x: 0, y: 0, duration: 0.06 });
		};

		const kick_up_dust = (strength: number) => {
			gsap.fromTo(
				'#wallz-dust .wallz__puff',
				{ opacity: 0.85, scale: 0.4, y: 0 },
				{ opacity: 0, scale: 1.5 + strength * 0.4, y: -14 * strength, duration: 0.55, ease: 'power2.out', stagger: 0.03, overwrite: true },
			);
		};

		const ground_impact = (strength: number) => {
			kick_up_dust(strength);
			shake_screen(strength);
			gsap.fromTo('#wallz-shadow', { scaleX: 1 }, { scaleX: 1.07, duration: 0.08, yoyo: true, repeat: 1 });
			gsap.fromTo(wallz_button, { y: 0 }, { y: 7 * strength, duration: 0.06, yoyo: true, repeat: 1, ease: 'power2.out' });
		};

		// Coil down, rise with overshoot and a roar, tremble at the top, then slam; the last slam hits hardest.
		const pound_the_ground = (show: gsap.core.Timeline) => {
			show
				.to('#wallz-torso', { scaleY: 0.95, duration: 0.22, ease: 'power2.out' })
				.to('#wallz-head', { y: 5, duration: 0.22, ease: 'power2.out' }, '<')
				.to(left_arm, { rotation: 10, duration: 0.22, ease: 'power2.out' }, '<')
				.to(right_arm, { rotation: -10, duration: 0.22, ease: 'power2.out' }, '<');

			for (const strength of slam_strengths) {
				show
					.to(left_arm, { rotation: raised_arm_degrees, duration: 0.36, ease: 'back.out(1.6)' })
					.to(right_arm, { rotation: -raised_arm_degrees, duration: 0.36, ease: 'back.out(1.6)' }, '<0.04')
					.to('#wallz-torso', { scaleY: 1.05, duration: 0.36, ease: 'power2.out' }, '<')
					.to('#wallz-head', { y: -6, rotation: -3, duration: 0.36, ease: 'power2.out' }, '<')
					.to('#wallz-mouth', { attr: { d: roaring_mouth }, duration: 0.16 }, '<0.08')
					.to(['#wallz-fangs', '#wallz-tongue'], { opacity: 1, duration: 0.1 }, '<')
					.to('#wallz-brow', { y: 2.5, duration: 0.16 }, '<')
					.to(left_arm, { rotation: raised_arm_degrees + 3, duration: 0.04, yoyo: true, repeat: 3 })
					.to(right_arm, { rotation: -raised_arm_degrees - 3, duration: 0.04, yoyo: true, repeat: 3 }, '<')
					.to(both_arms, { rotation: 0, duration: 0.09, ease: 'power3.in' })
					.to('#wallz-head', { y: 5, rotation: 2, duration: 0.09, ease: 'power3.in' }, '<')
					.to('#wallz-torso', { scaleY: 0.93, duration: 0.09, ease: 'power3.in' }, '<')
					.add(() => ground_impact(strength), '<0.085')
					.to('#wallz-torso', { scaleY: 1, duration: 0.3, ease: 'elastic.out(1, 0.5)' })
					.to('#wallz-head', { y: 0, rotation: 0, duration: 0.25, ease: 'power2.out' }, '<');
			}

			show
				.to('#wallz-mouth', { attr: { d: closed_mouth }, duration: 0.2 })
				.to(['#wallz-fangs', '#wallz-tongue'], { opacity: 0, duration: 0.1 }, '<')
				.to('#wallz-brow', { y: 0, duration: 0.2 }, '<')
				.to('#wallz-torso', { scaleY: 1.04, duration: 0.3, ease: 'sine.inOut', yoyo: true, repeat: 1 });
		};

		// The banana drops in from above and the hand catches it before it is raised to the mouth.
		const catch_the_banana = (show: gsap.core.Timeline) => {
			show
				.set('#wallz-banana', { opacity: 1, y: -banana_drop_height, rotation: 0 })
				.set('#wallz-bite-shape', { x: bite_edge_x_untouched })
				.set(fingers_over_banana, { opacity: 0 })
				.to('#wallz-banana', { y: 0, duration: 0.5, ease: 'power2.in' })
				.set(fingers_over_banana, { opacity: 1 })
				.to('#wallz-hand-r', { scale: 0.92, duration: 0.07, yoyo: true, repeat: 1 })
				.to('#wallz-head', { rotation: 4, y: 2, duration: 0.3, ease: 'power2.out' }, '<')
				.to('#wallz-pupils', { x: 2.5, y: 2.5, duration: 0.25 }, '<');
		};

		const raise_banana_to_mouth = (show: gsap.core.Timeline) => {
			show
				.to(right_arm_shapes, { attr: { d: eating_arm }, duration: 0.65, ease: 'power2.inOut' }, '+=0.1')
				.to('#wallz-hand-r', { ...mouth_hand_offset, duration: 0.65, ease: 'power2.inOut' }, '<')
				.to('#wallz-banana', { rotation: banana_toward_mouth_degrees, duration: 0.65, ease: 'power2.inOut' }, '<')
				.to('#wallz-head', { rotation: 0, y: 1, duration: 0.4, ease: 'power2.inOut' }, '<0.2')
				.to('#wallz-pupils', { x: 0, y: 0, duration: 0.3 }, '<');
		};

		const bite_chew_swallow = (show: gsap.core.Timeline) => {
			show.addLabel('banana_ready', `+=${pause_to_show_the_banana_seconds}`);
			for (const [bite_index, bite_edge_x] of bite_edge_x_after_each_bite.entries()) {
				show
					.to('#wallz-mouth', { attr: { d: roaring_mouth }, duration: 0.12, ease: 'power2.out' }, bite_index === 0 ? 'banana_ready' : undefined)
					.to('#wallz-head', { y: -2, rotation: -2, duration: 0.12 }, '<')
					.to('#wallz-mouth', { attr: { d: closed_mouth }, duration: 0.07, ease: 'power3.in' })
					.to('#wallz-bite-shape', { x: bite_edge_x, duration: 0.07, ease: 'power2.in' }, '<')
					.to('#wallz-head', { y: 1.5, rotation: 0, scaleX: 1.02, duration: 0.07 }, '<')
					.to('#wallz-mouth', { attr: { d: chewing_mouth }, duration: 0.12, ease: 'sine.inOut', yoyo: true, repeat: 1 })
					.to('#wallz-head', { y: 2.5, duration: 0.12, ease: 'sine.inOut', yoyo: true, repeat: 1 }, '<')
					.to('#wallz-head', { scaleX: 1, duration: 0.1 });
			}

			show
				.to('#wallz-head', { y: -3, duration: 0.22, ease: 'power2.out' })
				.to('#wallz-torso', { scaleY: 1.03, duration: 0.22 }, '<')
				.to('#wallz-head', { y: 0, duration: 0.3, ease: 'power2.inOut' })
				.to('#wallz-torso', { scaleY: 1, duration: 0.3 }, '<');
		};

		const drop_the_peel_and_settle = (show: gsap.core.Timeline) => {
			show
				.to('#wallz-banana', { y: 80, opacity: 0, duration: 0.45, ease: 'power2.in' })
				.to(right_arm_shapes, { attr: { d: resting_arm }, duration: 0.6, ease: 'power2.inOut' }, '<')
				.to('#wallz-hand-r', { x: 0, y: 0, duration: 0.6, ease: 'power2.inOut' }, '<')
				.set('#wallz-banana', { opacity: 0, y: 0, rotation: 0 })
				.set('#wallz-bite-shape', { x: bite_edge_x_untouched })
				.set(fingers_over_banana, { opacity: 0 })
				.to('#wallz-head', { y: -3, duration: 0.6, ease: 'sine.inOut' }, '+=0.05')
				.to('#wallz-torso', { scaleY: 1.06, duration: 0.6, ease: 'sine.inOut' }, '<')
				.to('#wallz-head', { y: 0, duration: 0.7, ease: 'sine.inOut' })
				.to('#wallz-torso', { scaleY: 1, duration: 0.7, ease: 'sine.inOut' }, '<');
		};

		wallz_button.addEventListener('click', () => {
			if (is_performing) return;
			is_performing = true;
			waving?.kill();
			waving = null;
			wallz_button.dataset.state = 'performing';
			wallz_status.textContent = wallz_button.dataset.actionStatus ?? '';
			gsap.to('#wallz-pupils', { x: 0, y: 0, duration: 0.2 });
			// Idle breathing animates the same arm, torso and head properties, so it must not run during the show.
			breathing.pause();

			const show = gsap.timeline({
				onComplete: () => {
					breathing.time(0).play();
					is_performing = false;
					wallz_button.dataset.state = 'idle';
					wallz_status.textContent = '';
				},
			});
			pound_the_ground(show);
			catch_the_banana(show);
			raise_banana_to_mouth(show);
			bite_chew_swallow(show);
			drop_the_peel_and_settle(show);
		});
	}
</script>


<style>
	.hero__wall {
		position: relative;
		background: var(--enamel);
		color: var(--enamel-text);
		border-bottom: 14px solid var(--enamel-deep);
	}

	.hero__grid {
		display: grid;
		align-items: end;
		gap: clamp(2.5rem, 6vw, 4rem);
		padding-block: clamp(1.75rem, 4vw, 2.75rem) clamp(1.75rem, 3.5vw, 2.5rem);
	}

	@media (min-width: 62rem) {
		.hero__grid {
			grid-template-columns: 1.15fr 0.85fr;
		}
	}

	.hero__name {
		font-size: clamp(3.6rem, 10vw, 6rem);
		font-weight: 800;
		font-stretch: 65%;
		line-height: 0.94;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.hero__name span {
		display: block;
	}

	.hero__role {
		margin-top: 1.1rem;
		color: var(--guide);
		font-size: clamp(1.25rem, 2.6vw, 1.7rem);
		font-weight: 700;
		font-stretch: 85%;
		line-height: 1.2;
		text-wrap: balance;
	}

	.hero__lead {
		max-width: 46ch;
		margin-top: 1rem;
		color: var(--enamel-text);
		font-size: 1.15rem;
		line-height: 1.55;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 1.75rem;
		margin-top: 2rem;
	}

	.hero .push-button {
		color: var(--enamel-text);
	}

	.hero__projects {
		border-color: var(--enamel-text);
		color: var(--enamel-text);
	}

	.hero__projects:hover {
		background: var(--enamel-deep);
	}

	.hero__social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.4rem;
		margin-top: 1.6rem;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.hero__social a {
		color: var(--enamel-muted);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.hero__social a:hover {
		color: var(--enamel-text);
		text-decoration: underline;
	}

	.hero__visual {
		display: grid;
		gap: 1.25rem;
	}

	/* A lit alcove in the wall, so the dark-furred exhibit reads against the enamel. */
	.hero__stage {
		--wallz-width: clamp(10rem, 22vw, 14rem);
		position: relative;
		display: grid;
		justify-items: center;
		padding-top: 1.5rem;
		background: color-mix(in srgb, var(--enamel) 55%, #f2efe4);
		box-shadow: inset 0 10px 18px -10px rgba(0, 0, 0, 0.45);
	}

	.hero__wallz {
		position: relative;
		z-index: 2;
		width: var(--wallz-width);
		margin-bottom: -0.6rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.hero__plinth {
		width: calc(var(--wallz-width) * 1.35);
		height: 3.2rem;
		background: var(--plinth);
		box-shadow: 0 16px 18px -10px rgba(0, 0, 0, 0.55);
	}

	.hero__hint {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		display: none;
		max-width: 9rem;
		color: var(--enamel-text);
		font-size: 0.8rem;
		font-style: italic;
	}

	@media (min-width: 40rem) {
		.hero__hint {
			display: block;
		}
	}

	.hero__wallz-status {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* The exhibit label, cast in brass. */
	.hero__plate {
