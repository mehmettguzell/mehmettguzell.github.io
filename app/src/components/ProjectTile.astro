---
import Icon from './Icon.astro';

interface Props {
	slug: string;
	index: number;
	name: string;
	short_name: string;
	tagline: string;
	architecture_styles: string[];
	context?: string;
	technologies: string[];
	status_label?: string;
	repository?: string;
	repository_label: string;
	pipeline_label?: string;
	open_label: string;
	close_label: string;
}

const { slug, index, name, short_name, tagline, architecture_styles, context, technologies, status_label, repository, repository_label, pipeline_label, open_label, close_label } =
	Astro.props;

const visible_technology_count = 4;
const visible_technologies = technologies.slice(0, visible_technology_count);
const hidden_technology_count = technologies.length - visible_technologies.length;
---

<div class="tile-wrap" data-reveal>
	<article class:list={['tile glass spot', { 'tile--in-progress': status_label }]}>
		<p class="tile__bar placard" aria-hidden="true">No. {String(index + 1).padStart(2, '0')} · {short_name}</p>
		<div class="tile__body">
			<ul class="tile__badges">
				{status_label && <li class="tile__badge tile__badge--status">{status_label}</li>}
				{architecture_styles.map((style) => <li class="tile__badge tile__badge--style">{style}</li>)}
				{context && <li class="tile__badge">{context}</li>}
			</ul>
			<div class="tile__heading">
				<h3 class="tile__name">
					<button type="button" class="tile__open" aria-haspopup="dialog" data-open-project={`${slug}-dialog`}>{name}</button>
				</h3>
				<p class="tile__tagline">{tagline}</p>
			</div>
			<ul class="tile__technologies">
				{visible_technologies.map((technology) => <li class="chip">{technology}</li>)}
				{hidden_technology_count > 0 && <li class="chip">+{hidden_technology_count}</li>}
			</ul>
			<div class="tile__footer">
				<span class="push-button tile__push" aria-hidden="true">
					<span class="push-button__cap"></span>
					<span class="push-button__label">{open_label}</span>
				</span>
				<span class="tile__proofs">
					{pipeline_label && <span class="tile__proof">{pipeline_label}</span>}
					{
						repository && (
							<a class="tile__source" href={repository} rel="noopener" target="_blank">
								{repository_label} <Icon name="external" />
							</a>
						)
					}
				</span>
			</div>
		</div>
	</article>

	<dialog id={`${slug}-dialog`} class="project-dialog" aria-label={name} data-project-slug={slug}>
		<button type="button" class="project-dialog__close" data-close-project aria-label={close_label}><Icon name="close" /></button>
		<slot />
	</dialog>
</div>

<style>
	.tile {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: clip;
		border-top: 6px solid var(--enamel);
		transition:
			box-shadow 0.15s ease,
			transform 0.15s ease;
	}

	.tile:hover,
	.tile:focus-within {
		box-shadow: 0 26px 26px -18px rgba(0, 0, 0, 0.45);
		transform: translateY(-3px);
	}

	/* The exhibit's brass number plate: number and name in one breath. */
	.tile__bar {
		padding: 0.6rem 1rem 0.55rem;
		background: var(--brass);
		color: var(--brass-ink);
		font-size: 0.95rem;
	}

	.tile__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 1.1rem;
		padding: clamp(1.1rem, 2.5vw, 1.4rem);
	}

	.tile__heading {
		display: grid;
		gap: 0.55rem;
	}

	.tile--in-progress {
		border-top: 6px solid transparent;
		border-image: repeating-linear-gradient(-45deg, var(--guide) 0 10px, #151614 10px 20px) 6 0 0 0;
	}

	.tile__badges,
	.tile__technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.tile__badge {
		padding: 0.2rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		color: var(--accent);
		font: 700 0.74rem var(--font-heading);
	}

	.tile__badge--status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border-color: color-mix(in srgb, var(--status) 50%, transparent);
		background: color-mix(in srgb, var(--status) 14%, transparent);
		color: var(--text);
	}

	.tile__badge--status::before {
		content: '';
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--status);
	}

	.tile__badge--style {
		border-color: color-mix(in srgb, var(--accent-2) 50%, transparent);
		background: color-mix(in srgb, var(--accent-2) 16%, transparent);
		color: var(--accent-2);
	}

	.tile__name {
		color: var(--text);
		font-size: clamp(1.25rem, 2vw, 1.45rem);
		font-weight: 800;
		line-height: 1.2;
	}

	/* The button's pseudo-element stretches over the whole tile, so the entire card opens the dialog. */
	.tile__open {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.tile__open::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
	}

	.tile__open:focus-visible::after {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.tile {
			transition: none;
		}
	}

	.tile__tagline {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		color: var(--muted);
		font-size: 0.93rem;
		line-height: 1.55;
	}

	.tile__technologies {
		margin-top: auto;
	}

	.tile__footer {
		display: flex;
		align-items: center;
		gap: 0.5rem 1rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--border);
		font: 700 0.85rem var(--font-heading);
	}

	.tile__push {
		--cap-size: 2.1rem;
		margin-right: auto;
		color: var(--text);
		font-size: 0.9rem;
	}

	/* Pressing anywhere on the exhibit presses its button. */
	.tile:active .tile__push .push-button__cap {
		transform: translateY(calc(var(--cap-size) * 0.08));
		box-shadow: 0 calc(var(--cap-size) * 0.03) 0 var(--signal-deep);
	}

	/* Proof links stack in a fixed two-line column so every exhibit's footer lines up. */
	.tile__proofs {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		justify-content: center;
		gap: 0.15rem;
		min-height: 2.9rem;
		text-align: right;
	}

	.tile__proof {
		color: var(--muted);
		font-weight: 500;
	}

	/* Sits above the stretched open button so the repository opens instead of the dialog. */
	.tile__source {
		position: relative;
		z-index: 2;
		color: var(--text);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
		text-underline-offset: 0.25em;
	}

	.tile__source:hover {
		color: var(--accent);
	}

	.project-dialog {
		width: min(72rem, calc(100% - 2rem));
		max-width: none;
		max-height: calc(100dvh - 2rem);
		margin: auto;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		overflow: auto;
		overscroll-behavior: contain;
	}

	.project-dialog::backdrop {
		background: rgb(0 0 0 / 0.65);
	}

	.project-dialog__close {
		position: sticky;
		top: 0.5rem;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		margin: 0 0.5rem -2.9rem auto;
		border: 2px solid var(--brass-ink);
		border-radius: var(--radius);
		background: var(--surface-strong);
		color: var(--text);
		font-size: 1.15rem;
		cursor: pointer;
	}

	.project-dialog__close:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Inside the dialog the diagram sticks to the dialog's own scroll area, not the page header offset. */
	.project-dialog :global(.project__inspector) {
		top: 1rem;
	}

	/* Leaves room in the window bar for the close button. */
	.project-dialog :global(.project__bar) {
		padding-right: 3.5rem;
	}

	:global(body:has(.project-dialog[open])) {
		overflow: hidden;
	}
</style>

<script>
	// Each open project lives at #<slug>, so it can be linked and Back closes it.
	const project_dialogs = [...document.querySelectorAll<HTMLDialogElement>('dialog[data-project-slug]')];
	const dialog_for_hash = () => project_dialogs.find((dialog) => location.hash === `#${dialog.dataset.projectSlug}`);
	let opened_with_history_entry: HTMLDialogElement | null = null;

	const sync_dialogs_with_hash = () => {
		const target = dialog_for_hash();
		for (const dialog of project_dialogs) {
			if (dialog !== target && dialog.open) dialog.close();
		}
		if (target && !target.open) target.showModal();
	};

	for (const dialog of project_dialogs) {
		const project_hash = `#${dialog.dataset.projectSlug}`;
		document.querySelector(`[data-open-project="${dialog.id}"]`)?.addEventListener('click', () => {
			if (location.hash !== project_hash) {
				history.pushState(null, '', project_hash);
				opened_with_history_entry = dialog;
			}
			dialog.showModal();
		});
		dialog.querySelector('[data-close-project]')?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		// Esc, ×, backdrop and Back all end here; only the first three still have the hash to remove.
		dialog.addEventListener('close', () => {
			if (location.hash !== project_hash) return;
			if (opened_with_history_entry === dialog) {
				opened_with_history_entry = null;
				history.back();
			} else {
				history.replaceState(null, '', location.pathname + location.search);
			}
		});
	}

	addEventListener('popstate', () => {
		opened_with_history_entry = null;
		sync_dialogs_with_hash();
	});
	sync_dialogs_with_hash();
</script>
