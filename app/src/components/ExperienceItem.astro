---
import Icon from './Icon.astro';
interface Props {
	role: string;
	summary: string;
	organization: string;
	location: string;
	period: string;
	highlights: string[];
	gained?: string;
	gained_label: string;
	technologies: string[];
	technologies_label: string;
	proof?: { label: string; url: string; title: string };
}

const { role, summary, organization, location, period, highlights, gained, gained_label, technologies, technologies_label, proof } = Astro.props;
---

<article class="experience glass spot" data-reveal>
	<span class="experience__dot" aria-hidden="true"></span>
	<div class="experience__head">
		<div>
			<p class="experience__period">{period}</p>
			<h3 class="experience__role">{role}</h3>
			<p class="experience__org"><strong>{organization}</strong> · {location}</p>
		</div>
		{
			proof && (
				<a class="experience__proof" href={proof.url} rel="noopener" target="_blank" title={proof.title}>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path d="M8 1.5 2.5 3.8v3.9c0 3.2 2.3 5.9 5.5 6.8 3.2-.9 5.5-3.6 5.5-6.8V3.8z" />
						<path d="m5.6 8 1.7 1.7 3.2-3.4" />
					</svg>
					{proof.label}
					<Icon name="external" />
				</a>
			)
		}
	</div>
	<p class="experience__summary">{summary}</p>
	<ul class="experience__highlights">
		{
			highlights.map((highlight) => {
				const [, highlight_label, highlight_text] = highlight.match(/^\*\*(.+?)\*\*\s*([\s\S]*)$/) ?? [];
				return highlight_label ? <li><strong>{highlight_label}</strong> {highlight_text}</li> : <li>{highlight}</li>;
			})
		}
	</ul>
	{
		gained && (
			<p class="experience__gained">
				<strong>{gained_label}</strong> {gained}
			</p>
		)
	}
	<ul class="experience__technologies" aria-label={technologies_label}>
		{technologies.map((technology) => <li class="chip">{technology}</li>)}
	</ul>
</article>

<style>
	.experience {
		padding: clamp(1.4rem, 3vw, 2.2rem);
	}

	.experience__dot {
		position: absolute;
		top: 2.15rem;
		left: calc(-1 * var(--timeline-offset, 2.2rem) - 0.4rem);
		width: 0.8rem;
		height: 0.8rem;
		border: 2px solid var(--accent);
		border-radius: 50%;
		background: var(--bg);
	}

	.experience__head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.experience__proof {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.85rem;
		border: 1px solid var(--brass-ink);
		border-radius: var(--radius);
		background: var(--brass);
		color: var(--brass-ink);
		font: 700 0.78rem var(--font-heading);
		text-decoration: none;
	}

	.experience__proof:hover {
		background: var(--brass-light);
	}

	.experience__proof svg {
		width: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.experience__technologies {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1.3rem;
		padding: 0;
		list-style: none;
	}

	.experience__period {
		color: var(--accent);
		font-family: var(--font-heading);
		font-size: 0.82rem;
	}

	.experience__role {
		margin-top: 0.35rem;
		font-size: clamp(1.3rem, 3vw, 1.7rem);
	}

	.experience__org {
		margin-top: 0.2rem;
		color: var(--muted);
	}

	.experience__org strong {
		color: var(--text);
	}

	.experience__summary {
		margin-top: 1rem;
		max-width: 70ch;
		color: var(--text);
		font-size: 1.1rem;
		font-weight: 500;
		line-height: 1.55;
	}

	.experience__highlights {
		display: grid;
		gap: 0.75rem;
		max-width: 72ch;
		margin-top: 1.1rem;
		padding: 0;
		list-style: none;
		color: var(--muted);
	}

	.experience__highlights li {
		position: relative;
		padding-left: 1.4rem;
	}

	.experience__gained {
		max-width: 72ch;
		margin-top: 1.1rem;
		color: var(--muted);
	}

	.experience__highlights strong,
	.experience__gained strong {
		color: var(--text);
	}

	.experience__highlights li::before {
		content: '';
		position: absolute;
		top: 0.7em;
		left: 0;
		width: 0.6rem;
		height: 3px;
		background: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.experience__proof {
			transition: none;
		}

		.experience__proof:hover {
			transform: none;
		}
	}
</style>
