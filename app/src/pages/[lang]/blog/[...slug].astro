---
import { getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { languages, t, default_language, localized_path, type Language } from '../../../i18n';
import { estimate_reading_minutes, get_adjacent_series_posts, get_published_posts_newest_first } from '../../../lib/blog';

export async function getStaticPaths() {
	const posts = await get_published_posts_newest_first();
	return languages.filter((lang) => lang !== default_language).flatMap((lang) => posts.map((post) => ({ params: { lang, slug: post.id }, props: { post } })));
}

const lang = (Astro.params.lang ?? default_language) as Language;
const { post } = Astro.props;
const { Content } = await render(post);
const date_format = new Intl.DateTimeFormat(lang, { dateStyle: 'long' });
const post_path = (target_post: typeof post) => localized_path(lang, `/blog/${target_post.id}/`);
const series = post.data.series ? await getEntry(post.data.series) : undefined;
const published_posts = series ? await get_published_posts_newest_first() : [];
const { previous, next } = get_adjacent_series_posts(published_posts, post);
---

<Layout lang={lang} title={`${post.data.title} · Mehmet Güzel`} description={post.data.summary} canonical_path={localized_path(post.data.lang, `/blog/${post.id}/`)}>
	<article class="post" lang={post.data.lang}>
		<a class="post__back" href={localized_path(lang, '/blog/')}><Icon name="arrow-left" /> {t(lang, 'blog.title')}</a>
		<h1>{post.data.title}</h1>
		<p class="post__meta">
			<time datetime={post.data.date.toISOString()}>{date_format.format(post.data.date)}</time>
			· {estimate_reading_minutes(post)} {t(lang, 'blog.reading_minutes')}
			{post.data.tags.length > 0 && <>· {post.data.tags.join(', ')}</>}
		</p>
		{
			series && (
				<p class="post__series">
					{t(lang, 'blog.series')}:{' '}
					<a href={localized_path(lang, `/blog/seri/${series.id}/`)}>{series.data.title}</a> · {post.data.order}/{series.data.total_posts}
				</p>
			)
		}
		<div class="post__body">
			<Content />
		</div>
		{
			series && (previous || next) && (
				<nav class="post__series-nav" aria-label={series.data.title}>
					{previous ? (
						<a href={post_path(previous)}>
							<Icon name="arrow-left" /> {t(lang, 'blog.previous')}: {previous.data.title}
						</a>
					) : (
						<span />
					)}
					{next && (
						<a href={post_path(next)}>
							{t(lang, 'blog.next')}: {next.data.title} <Icon name="arrow-right" />
						</a>
					)}
				</nav>
			)
		}
	</article>
</Layout>

<style>
	.post {
		width: min(100% - 2rem, 46rem);
		margin: 0 auto;
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.post__back {
		font-family: var(--font-heading);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.post h1 {
		margin: 1.25rem 0 0.75rem;
		font-size: clamp(2.2rem, 6vw, 3.8rem);
		font-weight: 800;
		font-stretch: 72%;
		line-height: 0.98;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.post__meta {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
		color: var(--muted);
		font-family: var(--font-heading);
		font-size: 0.82rem;
	}

	.post__series {
		margin: -1.5rem 0 2rem;
		color: var(--muted);
		font-family: var(--font-heading);
		font-size: 0.82rem;
	}

	.post__series-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-family: var(--font-heading);
		font-size: 0.9rem;
	}

	.post__series-nav a {
		max-width: 22rem;
		text-decoration: none;
	}

	.post__series-nav a:last-child {
		margin-left: auto;
		text-align: right;
	}

	.post__series-nav a:hover {
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.post__body {
		color: color-mix(in srgb, var(--text) 88%, var(--muted));
		font-size: 1.08rem;
		line-height: 1.8;
	}

	.post__body :global(h2),
	.post__body :global(h3) {
		margin: 2.6rem 0 0.9rem;
		color: var(--text);
	}

	.post__body :global(p),
	.post__body :global(ul),
	.post__body :global(ol) {
		margin-bottom: 1.2rem;
	}

	.post__body :global(ul),
	.post__body :global(ol) {
		padding-left: 1.4rem;
	}

	.post__body :global(code:not(pre code)) {
		padding: 0.1em 0.4em;
		border: 1px solid var(--border);
		border-radius: 0.2rem;
		background: var(--surface);
		font-family: var(--font-heading);
		font-size: 0.88em;
	}

	.post__body :global(pre) {
		margin-bottom: 1.5rem;
		padding: 1.2rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow-x: auto;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.post__body :global(.pipeline-diagram) {
		max-width: 28rem;
		margin-bottom: 1.5rem;
	}

	/* Code sits on the exhibit label stock instead of Shiki's pure white sheet. */
	:global(:root:not([data-theme='dark'])) .post__body :global(.astro-code) {
		background-color: var(--surface-strong) !important;
	}

	:global(:root[data-theme='dark']) .post__body :global(.astro-code),
	:global(:root[data-theme='dark']) .post__body :global(.astro-code span) {
		color: var(--shiki-dark) !important;
		background-color: var(--shiki-dark-bg) !important;
	}
</style>
